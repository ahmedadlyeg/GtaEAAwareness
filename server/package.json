{
  "name": "ea-awareness-hub-server",
  "version": "1.0.0",
  "private": true,
  "description": "Reference REST API for the GTA EA Awareness Hub (OTP login, assessments, sign-off, admin dashboard).",
  "main": "src/server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test test/api.test.js test/cert.test.js test/levels.test.js test/reviewer.test.js",
    "seed:questions": "node src/seed/seedQuestions.js",
    "seed:demo": "node src/seed/seedDemo.js",
    "create-reviewer": "node src/seed/createReviewer.js",
    "sync:content": "node src/seed/syncFromFrontend.js",
    "set-password": "node src/seed/setPassword.js"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^7.0.6"
  },
  "optionalDependencies": {
    "mssql": "^12.0.0"
  },
  "devDependencies": {
    "supertest": "^7.1.4"
  }
}
