# ---------------------------------------------------------------------------
# EA Awareness Hub server - copy to .env and adjust. Never commit .env.
# In production inject these from the secrets vault / Kubernetes secrets.
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=8080

# sqlite (local dev/tests) | mssql (production SQL Server)
DB_DRIVER=sqlite
SQLITE_PATH=./data/ea-hub.db
# mssql connection string (tedious/mssql format), e.g.
# Server=sql01.gta.local,1433;Database=EAHub;User Id=ea_hub_app;Password=***;Encrypt=true;TrustServerCertificate=false
MSSQL_CONNECTION_STRING=

# JWT signing secret: >= 32 random bytes (openssl rand -base64 48). Also used to pepper OTP hashes
# unless OTP_PEPPER is set.
JWT_SECRET=change-me-to-a-long-random-secret
JWT_TTL=8h
OTP_PEPPER=

# Who may sign in and who gets elevated roles on provisioning
ALLOWED_EMAIL_DOMAINS=gta.gov.qa
ADMIN_EMAILS=
EA_TEAM_EMAILS=
# Exam reviewers: every exam unlocked, unlimited preview sittings, no certificates,
# excluded from dashboards and exports. Create with: npm run create-reviewer
REVIEWER_EMAILS=exam.reviewer@gta.gov.qa

# OTP policy (contract: 6 digits, 10 min, 5 attempts, 3 requests per email per 15 min)
OTP_TTL_MIN=10
OTP_MAX_ATTEMPTS=5
OTP_MAX_REQUESTS_PER_WINDOW=3
OTP_REQUEST_WINDOW_MIN=15

# Assessment pass mark (fallback if a round has no pass_pct)
PASS_PCT=70
# Foundation certification: unlock at % of EA modules AND % of TOGAF topics completed;
# pass mark (overall); sittings per person (first + retakes); certificate id prefix
CERT_UNLOCK_PCT=80
CERT_PASS_PCT=70
CERT_MAX_ATTEMPTS=3
CERT_PREFIX=GTA-EAF
CERT_PREFIX_PRACTITIONER=GTA-EAP
CERT_PREFIX_ADVANCED=GTA-EAA

# Reporting time zone (Qatar has no DST; heatmap/logins-by-day are local)
TIMEZONE=Asia/Qatar

# Serve the SPA from this directory (relative to server/). Empty = API only.
STATIC_DIR=..

# CORS: comma-separated allowed origins. Empty = same-origin only.
CORS_ORIGIN=

# Set to the number of reverse-proxy hops (IIS/ARR, ingress) so req.ip is the client IP
TRUST_PROXY=0

# Per-IP rate limits (express-rate-limit), per 15 minutes
RATE_LIMIT_AUTH=30
# Password sign-in: lock an account for LOGIN_LOCK_MIN minutes after LOGIN_MAX_FAILURES wrong passwords
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MIN=15
# Lifetime of the set-password token issued after a sign-up / reset code is verified
SETUP_TOKEN_TTL_MIN=15
RATE_LIMIT_API=1000

# SMTP relay (GTA Exchange / Microsoft 365). If SMTP_HOST is empty a dev transport logs
# every e-mail (including OTP codes) to the console and keeps it in email_outbox.
SMTP_HOST=
SMTP_PORT=25
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="EA Awareness Hub <ea-hub-noreply@gta.gov.qa>"
# Public URL used in e-mail links
APP_BASE_URL=http://localhost:8080

# Outbox worker
OUTBOX_POLL_MS=5000
OUTBOX_MAX_ATTEMPTS=6

# Logging: info | debug | warn | error
LOG_LEVEL=info
