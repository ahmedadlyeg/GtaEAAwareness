# ===========================================================================
# EA Awareness Hub — PRODUCTION env for the Hostinger VPS.
# Copy to .env on the server and fill in the real values. NEVER commit .env.
#   cp .env.production.example .env && nano .env
# Generate secrets with:  openssl rand -base64 48
# ===========================================================================

NODE_ENV=production
PORT=8080

# ---- Database: SQLite file (persists across restarts; back it up) ----------
DB_DRIVER=sqlite
SQLITE_PATH=./data/ea-hub.db

# ---- Secrets (REQUIRED — replace both) -------------------------------------
JWT_SECRET=__RUN_openssl_rand_-base64_48__
OTP_PEPPER=__RUN_openssl_rand_-base64_32__
JWT_TTL=8h

# ---- Who may sign in / who is admin ---------------------------------------
# Change the domain if staff use a different email domain than gta.gov.qa.
ALLOWED_EMAIL_DOMAINS=gta.gov.qa
# Your own address gets the admin dashboard on first sign-in:
ADMIN_EMAILS=
EA_TEAM_EMAILS=
REVIEWER_EMAILS=exam.reviewer@gta.gov.qa

# ---- Public URL (used in e-mail links) ------------------------------------
APP_BASE_URL=https://YOUR_DOMAIN

# ---- Reverse proxy: nginx sits in front, so trust 1 hop -------------------
TRUST_PROXY=1

# ---- Serve the SPA from the parent folder (single origin) -----------------
STATIC_DIR=..
# Same-origin only; leave empty when the SPA is served by this server.
CORS_ORIGIN=

# ---- E-MAIL: Hostinger mailbox as SMTP relay ------------------------------
# Create a mailbox in hPanel (Emails) on your domain, e.g. no-reply@YOUR_DOMAIN.
# Hostinger SMTP: smtp.hostinger.com, port 465 (SSL) or 587 (STARTTLS).
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@YOUR_DOMAIN
SMTP_PASS=__THE_MAILBOX_PASSWORD__
MAIL_FROM="EA Awareness Hub <no-reply@YOUR_DOMAIN>"

# ---- Policy / limits (defaults are fine) ----------------------------------
OTP_TTL_MIN=10
OTP_MAX_ATTEMPTS=5
OTP_MAX_REQUESTS_PER_WINDOW=3
OTP_REQUEST_WINDOW_MIN=15
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MIN=15
SETUP_TOKEN_TTL_MIN=15
PASS_PCT=70
CERT_UNLOCK_PCT=80
CERT_PASS_PCT=70
CERT_MAX_ATTEMPTS=3
CERT_PREFIX=GTA-EAF
CERT_PREFIX_PRACTITIONER=GTA-EAP
CERT_PREFIX_ADVANCED=GTA-EAA
TIMEZONE=Asia/Qatar
RATE_LIMIT_AUTH=30
RATE_LIMIT_API=1000
OUTBOX_POLL_MS=5000
OUTBOX_MAX_ATTEMPTS=6
LOG_LEVEL=info
